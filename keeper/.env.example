# MUST match site/.dev-secret (or site's PAIRING_DERIVATION_SECRET) exactly --
# a mismatch derives different addresses than the ones already handed out.
PAIRING_DERIVATION_SECRET=

# Plain EOA or multisig; receives the 20% buyback share on every sweep.
BUYBACK_WALLET_ADDRESS=

# Funds Arbitrum gas top-ups for derived accounts. Only required once
# DRY_RUN=false.
KEEPER_OPERATIONAL_PRIVATE_KEY=

# Defaults to false left unset would be surprising -- be explicit.
# true (default if unset): logs every action, broadcasts nothing.
DRY_RUN=true

# --- Optional overrides (sane defaults in src/config.ts) ---
# ARC_RPC_URL=
# ARBITRUM_RPC_URL=
# ARGUS_PORTAL_ADDRESS=
# PAIRINGS_FILE_PATH=
# SWEEP_MIN_USDC=
# POLL_INTERVAL_MS=
